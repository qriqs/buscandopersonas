---
import { ArrowUp, ArrowUpRight } from '@lucide/astro';
import Brand from './Brand.astro';
import { contact, navigation } from '../business';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <Brand />
        <p>Agencia de investigación privada en Lima, Perú.</p>
      </div>
      <nav class="footer-links" aria-label="Secciones del sitio">
        {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <nav class="footer-links" aria-label="Redes y contacto">
        <a href={'mailto:' + contact.email}>Correo electrónico</a>
        <a href={contact.facebook}>Facebook <ArrowUpRight size={14} aria-hidden="true" /></a>
        <a href={contact.tiktok}>TikTok <ArrowUpRight size={14} aria-hidden="true" /></a>
      </nav>
      <a class="back-top" href="#inicio" aria-label="Volver arriba"><ArrowUp size={20} aria-hidden="true" /></a>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {contact.name}</span>
      <a href="/privacidad/">Privacidad y contacto</a>
    </div>
  </div>
</footer>
