---
import { ArrowRight } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Página no encontrada | BuscandoPersonas.org" description="La dirección solicitada no está disponible." noindex>
  <main id="contenido" class="inner-page wrap" tabindex="-1">
    <h1>Página no <em>encontrada.</em></h1>
    <p>La dirección solicitada no está disponible. Desde el inicio puedes consultar nuestros servicios o ponerte en contacto con el equipo.</p>
    <a class="button button--lime" href="/">Volver al inicio <ArrowRight size={17} aria-hidden="true" /></a>
  </main>
</SiteLayout>
