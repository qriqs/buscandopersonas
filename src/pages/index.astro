---
import {
  ArrowDown, ArrowDownRight, ArrowRight, ArrowUpRight, Camera, FileText,
  HeartHandshake, LockKeyhole, Mail, MapPin, MessageCircle, Phone, Plus, Search,
  ShieldCheck, UsersRound,
} from '@lucide/astro';
import { Image, Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import archive from '../assets/archivo-familiar.webp';
import photos from '../assets/fotografias.webp';
import directors from '../assets/directores.webp';
import { contact, otherServices, questions, whatsapp } from '../business';

const title = 'Búsqueda de personas en Perú | BuscandoPersonas.org';
const description = 'Agencia de investigación privada en Lima, especializada en búsqueda de personas y reencuentros familiares. Cuéntanos tu caso por WhatsApp o por formulario.';
const steps = [
  {
    title: 'Cuéntanos a quién buscas',
    detail: 'Comparte lo que recuerdas. Una fecha, un lugar o una fotografía pueden ser suficientes para empezar a conversar.',
  },
  {
    title: 'Revisamos qué se puede investigar',
    detail: 'Evaluamos la información disponible y conversamos contigo sobre el alcance, los costos y los próximos pasos.',
  },
  {
    title: 'Exploramos un posible reencuentro',
    detail: 'Si encontramos a la persona, el siguiente paso depende de las circunstancias y de su voluntad de retomar el contacto.',
  },
];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: contact.name,
  url: Astro.site?.href,
  description,
  image: new URL('/buscando-personas.jpg', Astro.site).href,
  telephone: '+51 999 934 443',
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address,
    addressLocality: 'Lima',
    postalCode: '15079',
    addressCountry: 'PE',
  },
  sameAs: [contact.facebook, contact.tiktok],
});
---

<SiteLayout title={title} description={description} image="/buscando-personas.jpg">
  <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  <main id="contenido" tabindex="-1">
    <span id="hero" class="anchor-alias"></span>
    <section class="hero wrap" data-hero aria-labelledby="hero-title">
      <div class="hero-visual">
        <div class="hero-plate" data-hero-plate>
          <Picture
            src={archive}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 700px) 100vw, (max-width: 1000px) 66vw, 900px"
            alt="Manos revisando fotografías antiguas de un álbum familiar"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <span class="hero-caption"><Camera size={14} aria-hidden="true" /> Imagen ilustrativa</span>
      </div>
      <div class="hero-content">
        <h1 id="hero-title">Volver a <em>encontrarnos.</em></h1>
        <p>Buscamos personas y ayudamos a reunir familias, en el Perú y más allá de sus fronteras.</p>
        <div class="hero-actions">
          <a href={whatsapp()} class="button button--lime" aria-label="Cuéntanos tu caso por WhatsApp">
            <MessageCircle size={19} aria-hidden="true" /> Cuéntanos tu caso <ArrowUpRight size={17} aria-hidden="true" />
          </a>
          <a class="hero-link" href="#como-trabajamos">
            Cómo trabajamos <ArrowDown size={16} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <div class="wrap">
      <ul class="trust-strip" aria-label="Sobre la agencia">
        <li><MapPin size={20} aria-hidden="true" /> Con base en Lima, Perú</li>
        <li><ShieldCheck size={20} aria-hidden="true" /> Exintegrantes de la PIP</li>
        <li><LockKeyhole size={20} aria-hidden="true" /> Consultas confidenciales</li>
      </ul>
    </div>

    <span id="services" class="anchor-alias"></span>
    <section id="servicios" class="section services wrap" aria-labelledby="services-title">
      <div class="section-intro">
        <h2 id="services-title">¿A quién <em>buscas?</em></h2>
        <p>Cada búsqueda empieza con una historia. Si te separan años, kilómetros o preguntas pendientes, podemos ayudarte a dar el primer paso.</p>
      </div>
      <div class="services-layout">
        <article class="search-card">
          <div class="search-card-visual" aria-hidden="true">
            <span class="search-orbit"></span>
            <span class="search-orbit"></span>
            <span class="search-orbit"></span>
            <div class="search-icon"><Search size={28} stroke-width={1.6} /></div>
          </div>
          <div class="search-card-copy">
            <h3>Búsqueda de personas</h3>
            <p>Madres y padres biológicos, hijos, hermanos, familiares y amistades con quienes perdiste el contacto.</p>
            <a href={whatsapp()} class="text-link">Consultar por una búsqueda <ArrowUpRight size={17} aria-hidden="true" /></a>
          </div>
        </article>
        <div class="service-list">
          <h3>Otros servicios de investigación</h3>
          {otherServices.map(({ title, description }) => (
            <details class="accordion">
              <summary>{title}<span class="accordion-icon"><Plus size={18} aria-hidden="true" /></span></summary>
              <div class="accordion-body">
                <p>{description}</p>
                <a
                  href={whatsapp(`Hola, quisiera orientación sobre el servicio de ${title.toLowerCase()}.`)}
                  class="text-link"
                >
                  Consultar por este servicio <ArrowUpRight size={15} aria-hidden="true" />
                </a>
              </div>
            </details>
          ))}
        </div>
      </div>
      <aside class="urgent-note" aria-label="Orientación para una desaparición reciente">
        <ShieldCheck size={20} aria-hidden="true" />
        <p><strong>¿Una desaparición reciente?</strong> En el Perú puedes denunciarla de inmediato ante la Policía.</p>
        <a class="text-link" href={contact.missingPersonReport}>Cómo denunciar <ArrowUpRight size={16} aria-hidden="true" /></a>
      </aside>
    </section>

    <section id="como-trabajamos" class="process-section section" aria-labelledby="process-title">
      <div class="wrap process-layout">
        <figure class="process-figure">
          <div class="process-image">
            <Image
              src={photos}
              widths={[400, 720, 880]}
              sizes="(max-width: 760px) 90vw, 440px"
              alt="Una mano sostiene una fotografía antigua sobre una caja de recuerdos"
              loading="lazy"
            />
          </div>
          <figcaption><span></span> Una fotografía también puede ser una pista.</figcaption>
        </figure>
        <div class="process-copy">
          <h2 id="process-title">Todo empieza<br /> con <em>una pista.</em></h2>
          <ol class="process-steps">
            {steps.map(({ title, detail }, index) => (
              <li>
                <span class="step-index" aria-hidden="true">0{index + 1}</span>
                <div><h3>{title}</h3><p>{detail}</p></div>
              </li>
            ))}
          </ol>
          <a href="#contacto" class="text-link">Elegir cómo contactar <ArrowDownRight size={18} aria-hidden="true" /></a>
          <div class="process-route" aria-hidden="true"><span data-route></span></div>
        </div>
      </div>
    </section>

    <span id="about" class="anchor-alias"></span>
    <span id="team" class="anchor-alias"></span>
    <section id="nosotros" class="section team wrap" aria-labelledby="team-title">
      <div class="team-layout">
        <div class="team-copy">
          <h2 id="team-title">Las personas<br /> <em>detrás de la búsqueda.</em></h2>
          <p>Somos una agencia de investigación privada en Lima, especializada en la búsqueda de personas y los reencuentros familiares.</p>
          <p>Nuestro equipo reúne a exintegrantes de la Policía de Investigaciones del Perú (PIP) y profesionales del derecho, la docencia y el trabajo social.</p>
          <a class="text-link" href={contact.facebook}>Conoce nuestra página en Facebook <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
        <figure class="team-figure">
          <div class="team-image">
            <Image
              src={directors}
              widths={[400, 720, 820]}
              sizes="(max-width: 760px) 90vw, 490px"
              alt="Adolfo y Martín, directores de BuscandoPersonas.org"
              loading="lazy"
            />
          </div>
          <figcaption><UsersRound size={17} aria-hidden="true" /> <span><strong>Adolfo y Martín</strong> · Dirección de BuscandoPersonas.org</span></figcaption>
        </figure>
      </div>
    </section>

    <section id="preguntas" class="faq-section section" aria-labelledby="faq-title">
      <div class="wrap faq-layout">
        <div class="faq-intro">
          <h2 id="faq-title">Antes de <em>empezar.</em></h2>
          <p>Respuestas a preguntas frecuentes sobre una búsqueda.</p>
        </div>
        <div class="faq-list">
          {questions.map(({ question, answer }) => (
            <details class="accordion">
              <summary>{question}<span class="accordion-icon"><Plus size={18} aria-hidden="true" /></span></summary>
              <div class="accordion-body"><p>{answer}</p></div>
            </details>
          ))}
          <details class="accordion">
            <summary>¿Qué información conviene compartir al inicio?<span class="accordion-icon"><Plus size={18} aria-hidden="true" /></span></summary>
            <div class="accordion-body">
              <p>Describe brevemente tu caso. Antes de enviar documentos, fotos privadas o datos de menores, pregúntanos qué información necesitamos y por qué canal compartirla.</p>
              <a href="/privacidad/" class="text-link">Privacidad y contacto <ArrowRight size={17} aria-hidden="true" /></a>
            </div>
          </details>
        </div>
      </div>
    </section>

    <span id="contact" class="anchor-alias"></span>
    <section id="contacto" class="contact-section section wrap" aria-labelledby="contact-title">
      <div class="contact-panel">
        <div class="contact-main">
          <HeartHandshake size={32} stroke-width={1.4} aria-hidden="true" />
          <h2 id="contact-title">Hablemos de <em>tu búsqueda.</em></h2>
          <p>Cuéntanos a quién buscas para que podamos orientar tu consulta. Puedes empezar con lo que recuerdas.</p>
          <div class="contact-actions">
            <a class="button button--lime" href={whatsapp()}>
              <MessageCircle size={19} aria-hidden="true" /> Escribir por WhatsApp <ArrowUpRight size={17} aria-hidden="true" />
            </a>
            <a class="button button--light-outline" href={contact.form} aria-describedby="form-note">
              <FileText size={17} aria-hidden="true" /> Abrir formulario <ArrowUpRight size={17} aria-hidden="true" />
            </a>
          </div>
          <p class="form-note" id="form-note">El formulario se abre en Jotform. <a href="/privacidad/">Información sobre privacidad.</a></p>
        </div>
        <address class="contact-address">
          <div>
            <Phone size={20} aria-hidden="true" />
            <div><strong>Teléfono</strong><a href={contact.mobileHref}>{contact.mobile}</a><a href={contact.phoneHref}>{contact.phone}</a></div>
          </div>
          <div>
            <Mail size={20} aria-hidden="true" />
            <div><strong>Correo</strong><a href={'mailto:' + contact.email}>{contact.email}</a></div>
          </div>
          <div>
            <MapPin size={20} aria-hidden="true" />
            <div><strong>Dirección</strong><span>{contact.address}<br />{contact.locality}</span></div>
          </div>
        </address>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  import '../scripts/motion';
</script>
